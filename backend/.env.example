# ==========================================
# Server & Environment Configuration
# ==========================================
# PORT=5000 (Optional: defaults to 5000 locally; cloud platforms like Render set this automatically)
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.vercel.app
APP_URL=https://your-frontend-domain.vercel.app

# ==========================================
# Database Configuration (MongoDB Atlas)
# ==========================================
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.b872qiu.mongodb.net/school_management?retryWrites=true&w=majority&appName=Cluster0
RESET_DB=false

# ==========================================
# Authentication & Security
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
COOKIE_SAME_SITE=none

# ==========================================
# Production Demo Seeding Guardrails
# ==========================================
# Required only if SEED_DEFAULT_DATA=true in production:
# DEFAULT_ADMIN_PASSWORD=YourStrongAdminPassword123!

# ==========================================
# AI Services (Google Gemini)
# ==========================================
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# ==========================================
# Centralized Transactional Email Engine
# Multi-Tier Fallback Architecture:
# Tier 1 (Primary): Resend Cloud REST API (Fast HTTP, no blocked SMTP ports)
# Tier 2 (Secondary): Real-Time Gmail SMTP (Google 16-char App Password)
# Tier 3 (Tertiary): Mailtrap Sandbox / Custom SMTP (AWS SES, Mailgun, SendGrid)
# Tier 4 (Quaternary): Safe Development Simulator (Zero-crash fallback)
# ==========================================

# Sender Display Identities:
FROM_EMAIL="SchoolSync Notifications" <notifications@schoolsync.com>
EMAIL_FROM="SchoolSync Notifications" <notifications@schoolsync.com>

# Tier 1: Resend REST API (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=SchoolSync <onboarding@resend.dev>

# Tier 2: Quick Gmail SMTP Shorthand
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
GMAIL_APP_PASSWORD=your_16_character_google_app_password

# Tier 3: Standard Custom SMTP / Mailtrap Sandbox
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASS=your_mailtrap_pass
SMTP_SECURE=false

# Background Email Cron Interval (in hours)
CRON_INTERVAL_HOURS=24