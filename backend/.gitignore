# ==========================================
# Backend .gitignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
out/
build/
*.tgz

# User Uploads & Media Assets (Ignore files, preserve folder)
uploads/*
!uploads/.gitkeep

# Environment & Secret Files (STRICTLY PROTECTED)
.env
.env.*
*.env
!.env.example
!.env.sample

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & Coverage
coverage/
*.lcov

# Caches
.eslintcache
.cache/
*.tsbuildinfo

# IDE & OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
