# ==========================================
# SchoolSync Enterprise .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Production & Build Artifacts
dist/
dist-ssr/
out/
build/
*/dist/
*/build/
*.tgz
*.tar.gz

# User Uploaded Media & Static Storage (Ignore files, preserve folder)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Environment & Secret Configuration (STRICTLY PROTECTED)
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
!.env.example
!**/.env.example
!.env.sample
!**/.env.sample

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Code Coverage & Testing
coverage/
*.lcov
.nyc_output/

# Caches & Temp Files
.eslintcache
.cache/
.parcel-cache/
.vite/
*/.vite/
*.tsbuildinfo
*.tmp
*.temp

# IDE & Editor Files
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn
*.bak

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
