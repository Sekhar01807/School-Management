# ==========================================
# Frontend .gitignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
dist-ssr/
out/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & Secret Files (STRICTLY PROTECTED)
.env
.env.*
*.env
!.env.example
!.env.sample

# Caches
.eslintcache
.cache/
.vite/
*.tsbuildinfo

# Editor & OS Files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
